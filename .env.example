# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: gemini, sonnet or opus. Sonnet and Opus need Claude Code installed and logged in.
DEFAULT_MODEL=gemini
# Optional: where recipes are saved. Defaults to the recipes folder inside this project.
RECIPES_DIR=
# Optional, for exporting to Notion. Run setup_notion.py to create the database.
NOTION_TOKEN=
NOTION_DATABASE_ID=
